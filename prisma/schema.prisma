// NEXUS AI — Phase 1 schema
// Money is always Decimal(14,2). Never Float.
// Demo rows carry isDemo = true and are excluded unless DEMO_MODE is on.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Auth (Auth.js adapter shape) ─────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  image             String?
  emailVerified     DateTime?
  passwordHash      String?
  passwordChangedAt DateTime?
  isActive          Boolean   @default(true)
  mfaEnabled        Boolean   @default(false)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  title             String?
  departmentId      String?
  isDemo            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  department      Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  accounts        Account[]
  sessions        Session[]
  mfaSecret       MfaSecret?
  recoveryCodes   RecoveryCode[]
  roles           UserRole[]
  managedProjects Project[]       @relation("ProjectManager")
  memberships     ProjectMember[]
  tasks           Task[]
  activities      Activity[]
  auditLogs       AuditLog[]

  @@index([departmentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  mfaVerified  Boolean  @default(false)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model MfaSecret {
  userId     String    @id
  secretEnc  String // AES-256-GCM encrypted TOTP secret (base32), key from MFA_ENCRYPTION_KEY
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── RBAC ─────────────────────────

enum RoleKey {
  SUPER_ADMIN
  CEO
  PROJECT_MANAGER
  FINANCE_MANAGER
  DEVELOPER
  QA_ENGINEER
  VIEWER
}

model Role {
  id          String     @id @default(cuid())
  key         RoleKey    @unique
  name        String
  description String?
  users       UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ───────────────────────── Organisation ─────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  invoices  Invoice[]
  approvals ClientApproval[]
}

// ───────────────────────── Projects ─────────────────────────

enum ProjectCategory {
  GAME_DEVELOPMENT
  WEB_DEVELOPMENT
  MOBILE_APPLICATION
  SOFTWARE_DEVELOPMENT
  UI_UX_DESIGN
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  DELAYED
}

model Project {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  category    ProjectCategory
  status      ProjectStatus   @default(PLANNING)
  health      ProjectHealth   @default(ON_TRACK)
  budget      Decimal         @db.Decimal(14, 2)
  currency    String          @default("USD")
  progress    Int             @default(0) // 0..100, maintained by service layer
  startDate   DateTime?
  deadline    DateTime?
  completedAt DateTime?
  managerId   String?
  clientId    String?
  isDemo      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  manager    User?            @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members    ProjectMember[]
  tasks      Task[]
  invoices   Invoice[]
  expenses   Expense[]
  approvals  ClientApproval[]
  activities Activity[]

  @@index([status])
  @@index([deadline])
  @@index([managerId])
  @@index([clientId])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("Contributor")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  dueDate     DateTime?
  completedAt DateTime?
  isDemo      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
}

// ───────────────────────── Finance (Phase 1 minimal, expanded in Phase 2) ─────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id        String        @id @default(cuid())
  number    String        @unique
  projectId String?
  clientId  String?
  amount    Decimal       @db.Decimal(14, 2)
  currency  String        @default("USD")
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime
  dueAt     DateTime
  paidAt    DateTime?
  isDemo    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([paidAt])
  @@index([projectId])
  @@index([clientId])
}

enum ExpenseCategory {
  SALARIES
  SOFTWARE
  INFRASTRUCTURE
  MARKETING
  CONTRACTORS
  OFFICE
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  projectId   String?
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("USD")
  incurredAt  DateTime
  isDemo      Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([incurredAt])
  @@index([projectId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClientApproval {
  id          String         @id @default(cuid())
  projectId   String
  clientId    String?
  title       String
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  resolvedAt  DateTime?
  isDemo      Boolean        @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([projectId])
}

// ───────────────────────── Activity & Audit ─────────────────────────

model Activity {
  id        String   @id @default(cuid())
  type      String // e.g. project.created, task.completed, invoice.paid
  message   String
  actorId   String?
  projectId String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([projectId])
}

/// Append-only. A database trigger rejects UPDATE and DELETE on this table.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  outcome      String   @default("success") // success | denied | failure
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

/// Fixed-window counters for rate limiting (no Redis dependency in Phase 1).
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
