# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Use a least-privilege application role.
DATABASE_URL="postgresql://nexus:password@localhost:5432/nexus_dev"
# On Vercel, POSTGRES_URL (Prisma Postgres) is accepted as an alias for DATABASE_URL.
# Optional direct (non-pooled) connection used for migrations (Neon/Vercel set this automatically).
# DATABASE_URL_UNPOOLED=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical public URL of the app (used for callbacks and origin checks)
AUTH_URL="http://localhost:3000"

# 32-byte base64 key for encrypting TOTP secrets at rest — generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=""

# When "true", seed inserts clearly-labelled demo data and the UI shows a demo banner.
DEMO_MODE="false"

# Initial Super Admin created by `npm run db:seed` (only if no users exist). Change the password after first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
